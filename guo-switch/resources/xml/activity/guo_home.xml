<brls:AppletFrame id="guo/frame" title="果剧 · Switch" footerHidden="false">
    <brls:Box axis="column" paddingLeft="30" paddingRight="30" paddingTop="12">
        <brls:Box axis="row" height="52" marginBottom="10">
            <brls:Box id="guo/categories" axis="row" grow="1"/>
            <brls:Button id="guo/source" text="站源: 剧果" width="130" marginRight="12"/>
            <brls:Button id="guo/search" text="搜索" width="112" marginRight="12"/>
            <brls:Button id="guo/history" text="历史" width="112" marginRight="12"/>
            <brls:Button id="guo/refresh" text="刷新" width="112"/>
        </brls:Box>
        <brls:Label id="guo/status" text="正在加载剧果分类…" fontSize="18" marginBottom="14"/>
        <RecyclingGrid id="guo/grid" grow="1" itemHeight="150" itemSpace="16" spanCount="3" preFetchLine="1"/>
    </brls:Box>
</brls:AppletFrame>
